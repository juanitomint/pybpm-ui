# PyBPM Editor — Environment Configuration
# Copy to .env and adjust values as needed.

# pybpm-api backend URL (identity provider + model persistence)
PYBPM_API_URL=http://localhost:5000

# Port the editor FastAPI app listens on
APP_PORT=3000

# Environment (development | production) — controls debug mode
ENVIRONMENT=development

# Debug / hot-reload
DEBUG=true
